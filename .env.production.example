# Copiar como .env.production en la VPS. NO subir .env.production al repo.
DOMAIN=tramites.TU-DOMINIO.cl
APP_NAME="Navarro Propiedades"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tramites.TU-DOMINIO.cl
APP_KEY=
APP_TIMEZONE=America/Santiago
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
SESSION_SECURE_COOKIE=true
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Mantener versiones compatibles con compose.yaml de Sail
PHP_VERSION=8.5
MYSQL_IMAGE=mysql:8.4
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=navarro_propiedades
DB_USERNAME=navarro_app
DB_PASSWORD=GENERAR_PASSWORD_ALEATORIA
MYSQL_ROOT_PASSWORD=GENERAR_OTRA_PASSWORD_ALEATORIA

# Para 2GB de RAM: sin Redis ni worker adicional inicialmente
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local
